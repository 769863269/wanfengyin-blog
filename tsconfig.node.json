{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    // vite.config.ts 的相对导入一律带 .ts 扩展名：Vite 的 native config loader
    // （未来主版本的默认值）走 Node 原生解析，不再做扩展名补全
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    /* vite.config.ts 的 sitemap 插件会引用 src 下的数据/配置模块 */
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true
  },
  "include": [
    "vite.config.ts",
    "src/data/posts.generated.ts",
    "src/data/pages.generated.ts",
    "src/config/site.ts",
    "src/types/index.ts"
  ]
}
