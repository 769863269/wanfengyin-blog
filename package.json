{
  "name": "wanfengyin-blog",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "晚风吟个人开发博客 —— 基于 Vite + Vue 3 + TypeScript 的静态博客",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "posts": "node scripts/build-posts.mjs",
    "predev": "npm run posts",
    "dev": "vite",
    "prebuild": "npm run posts",
    "build": "vue-tsc -b && vite build",
    "postbuild": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vite build --config vite.smoke.config.ts && node scripts/smoke.mjs"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
