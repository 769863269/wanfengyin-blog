node_modules
dist
dist-ssr
# 通配：clean-smoke.mjs 在删除被 safe-delete 拦截时会把目录改名为
# dist-smoke.old-<ts>，只写 dist-smoke 会漏掉它们（曾被 git add -A 误提交）
dist-smoke*
coverage
.DS_Store
*.local
.vite
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.tsbuildinfo

# 临时 jsdom 验证脚本
.check-*.mjs

# Studio 本地运营数据（回收站/操作日志/作者名单）
.studio/

# Studio 临时冒烟脚本（依赖本机 jsdom，不入库）
scripts/**/*.tmp.mjs

# 本机 safe-delete 拦截删除的临时文件隔离区
scripts/.trash-tmp/

# 本地 git 配置（身份/HTTP 版本等，跨机器各填各的，不上传）
git.config.local

# 密钥 / 本地环境 / 数据库 / 编辑器备份
# 仓库是 public：这些一旦被 add 进历史就删不干净，必须在源头忽略
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.sqlite
*.sqlite3
*.bak
*.orig
*.rej

# 构建期产物：「完整 HTML 独立页」静态文件（由 build-pages.mjs 从 content/pages 重建）
public/page-html/
